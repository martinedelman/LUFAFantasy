generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("user")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  otpVerifications     OtpVerification[]
  requestedCorrections GameEventCorrection[] @relation("CorrectionRequester")
  reviewedCorrections  GameEventCorrection[] @relation("CorrectionReviewer")
  auditLogs            AdminAuditLog[]
  digitalCredentials   DigitalCredential[]
  analyticsReports     AnalyticsReport[]
  sellerMemberships    CommerceSellerMember[]
  commerceOrders       CommerceOrder[]
  tournamentRegistrations CommerceTournamentRegistration[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model AnalyticsReport {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  name        String
  description String   @default("")
  scope       String   @default("personal")
  filters     Json
  widgets     Json
  layouts     Json
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, scope])
  @@index([scope, updatedAt])
  @@map("analytics_reports")
}

model Tournament {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  season               String
  year                 Int
  startDate            DateTime  @map("start_date")
  endDate              DateTime  @map("end_date")
  registrationDeadline DateTime? @map("registration_deadline")
  status               String    @default("upcoming")
  format               String    @default("league")
  playoffCriteria      String?   @map("playoff_criteria")
  rules                Json?
  prizes               Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  legacyDivisions Division[]           @relation("LegacyDivisionTournament")
  legacyTeams     Team[]               @relation("LegacyTeamTournament")
  divisions       TournamentDivision[]
  teams           TournamentTeam[]
  games           Game[]
  standings       Standing[]
  playerStats     PlayerStatistics[]
  teamStats       TeamStatistics[]
  commerceItems   CommerceItem[]
  commerceRegistrations CommerceTournamentRegistration[]

  @@unique([name, year])
  @@index([status])
  @@index([playoffCriteria])
  @@index([startDate])
  @@map("tournaments")
}

model Division {
  id           String   @id @default(cuid())
  name         String
  category     String
  ageGroup     String?  @map("age_group")
  tournamentId String?  @map("tournament_id")
  maxTeams     Int?     @map("max_teams")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  legacyTournament Tournament?          @relation("LegacyDivisionTournament", fields: [tournamentId], references: [id], onDelete: SetNull)
  tournaments      TournamentDivision[]
  membershipTeams  DivisionTeam[]
  primaryTeams     Team[]               @relation("TeamPrimaryDivision")
  games            Game[]
  standings        Standing[]
  playerStats      PlayerStatistics[]
  teamStats        TeamStatistics[]

  @@index([name, category])
  @@index([category])
  @@index([tournamentId])
  @@map("divisions")
}

model Team {
  id               String   @id @default(cuid())
  name             String
  shortName        String?  @map("short_name")
  logo             String?
  backgroundImage  String?  @map("background_image")
  colors           Json
  divisionId       String   @map("division_id")
  tournamentId     String?  @map("tournament_id")
  coach            Json?
  coaches          Json?
  contact          Json
  registrationDate DateTime @map("registration_date")
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  division            Division         @relation("TeamPrimaryDivision", fields: [divisionId], references: [id], onDelete: Restrict)
  legacyTournament    Tournament?      @relation("LegacyTeamTournament", fields: [tournamentId], references: [id], onDelete: SetNull)
  tournaments         TournamentTeam[]
  divisionMemberships DivisionTeam[]
  playerMemberships   TeamPlayer[]
  players             Player[]
  homeGames           Game[]           @relation("GameHomeTeam")
  awayGames           Game[]           @relation("GameAwayTeam")
  events              GameEvent[]
  standings           Standing[]
  teamStats           TeamStatistics[]
  fantasyDefensePicks FantasyDraftPick[] @relation("FantasyDraftPickDefenseTeam")
  fantasyDefenseFavorites FantasyPlayerFavorite[] @relation("FantasyFavoriteDefenseTeam")

  @@unique([name, divisionId])
  @@index([divisionId])
  @@index([tournamentId])
  @@index([status])
  @@map("teams")
}

model Player {
  id                String   @id @default(cuid())
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  profilePicture    String?  @map("profile_picture")
  email             String?
  phone             String?
  dateOfBirth       DateTime @map("date_of_birth")
  teamId            String   @map("team_id")
  jerseyNumber      Int?     @map("jersey_number")
  position          String
  secondaryPosition String?  @map("secondary_position")
  height            Float?
  weight            Float?
  experience        String?
  emergencyContact  Json?    @map("emergency_contact")
  registrationDate  DateTime @map("registration_date")
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  team             Team                    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  teamMemberships  TeamPlayer[]
  presentGames     GamePresentPlayer[]
  events           GameEvent[]             @relation("EventPlayer")
  importMigrations PlayerImportMigration[]
  playerStats      PlayerStatistics[]
  fantasyDraftPicks FantasyDraftPick[]
  fantasyFavorites  FantasyPlayerFavorite[]
  digitalCredentials DigitalCredential[]

  @@index([firstName, lastName])
  @@index([teamId])
  @@index([position])
  @@index([secondaryPosition])
  @@index([status])
  @@map("players")
}

model Judge {
  id             String   @id @default(cuid())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  normalizedName String   @unique @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  digitalCredentials DigitalCredential[]

  @@index([firstName, lastName])
  @@map("judges")
}

model Game {
  id              String    @id @default(cuid())
  tournamentId    String    @map("tournament_id")
  divisionId      String    @map("division_id")
  homeTeamId      String?   @map("home_team_id")
  awayTeamId      String?   @map("away_team_id")
  venue           Json
  scheduledDate   DateTime  @map("scheduled_date")
  actualStartTime DateTime? @map("actual_start_time")
  actualEndTime   DateTime? @map("actual_end_time")
  status          String    @default("scheduled")
  phase           String    @default("regular")
  playoffSlot     String?   @map("playoff_slot")
  week            Int?
  round           String?
  officials       Json
  score           Json
  statistics      Json
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tournament     Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  division       Division              @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  homeTeam       Team?                 @relation("GameHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam       Team?                 @relation("GameAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  presentPlayers GamePresentPlayer[]
  events         GameEvent[]
  corrections    GameEventCorrection[]

  @@index([tournamentId, divisionId])
  @@index([scheduledDate])
  @@index([status])
  @@index([phase])
  @@index([tournamentId, divisionId, playoffSlot])
  @@index([week])
  @@map("games")
}

model GameEvent {
  id          String   @id @default(cuid())
  gameId      String   @map("game_id")
  teamId      String   @map("team_id")
  playerId    String?  @map("player_id")
  quarter     Int
  sequence    Int
  time        String?
  type        String
  description String?
  yards       Float?
  points      Float?
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  game        Game                  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  player      Player?               @relation("EventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  corrections GameEventCorrection[]

  @@unique([gameId, sequence])
  @@index([playerId, gameId])
  @@index([teamId, gameId])
  @@index([type, points, playerId])
  @@map("game_events")
}

model Standing {
  id                 String   @id @default(cuid())
  divisionId         String   @map("division_id")
  tournamentId       String   @map("tournament_id")
  teamId             String   @map("team_id")
  position           Int
  wins               Int      @default(0)
  losses             Int      @default(0)
  ties               Int      @default(0)
  pointsFor          Int      @default(0) @map("points_for")
  pointsAgainst      Int      @default(0) @map("points_against")
  pointsDifferential Int      @default(0) @map("points_differential")
  percentage         Float    @default(0)
  streak             String?
  lastFiveGames      String?  @map("last_five_games")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([divisionId, tournamentId, teamId])
  @@index([tournamentId])
  @@index([divisionId, position])
  @@index([divisionId, percentage])
  @@map("standings")
}

model OtpVerification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  email       String
  purpose     String
  tokenHash   String    @unique @map("token_hash")
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
  @@index([userId, purpose, consumedAt])
  @@map("otp_verifications")
}

model GameEventCorrection {
  id               String    @id @default(cuid())
  gameId           String    @map("game_id")
  eventId          String?   @map("event_id")
  operation        String
  status           String    @default("pending")
  proposedEvent    Json?     @map("proposed_event")
  originalEvent    Json?     @map("original_event")
  requestedById    String    @map("requested_by_id")
  requestedByName  String?   @map("requested_by_name")
  requestedByEmail String?   @map("requested_by_email")
  reviewedById     String?   @map("reviewed_by_id")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewNote       String?   @map("review_note")
  createdAt        DateTime  @default(now()) @map("created_at")

  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  event       GameEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  requestedBy User       @relation("CorrectionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?      @relation("CorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([gameId, status])
  @@index([requestedById, status])
  @@map("game_event_corrections")
}

model PlayerImportMigration {
  sourceKey     String  @id @map("source_key")
  email         String
  marcaTemporal String  @map("marca_temporal")
  firstName     String  @map("first_name")
  lastName      String  @map("last_name")
  playerId      String? @map("player_id")

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("player_import_migrations")
}

model SiteSettings {
  key                     String   @id @default("global")
  whatsappMessageTemplate String   @map("whatsapp_message_template")
  contactEmail            String   @default("") @map("contact_email")
  contactWhatsapp         String   @default("") @map("contact_whatsapp")
  instagramUrl            String   @default("") @map("instagram_url")
  whatsappChannelUrl      String   @default("") @map("whatsapp_channel_url")
  sponsors                Json
  homepageAnnouncement    Json     @map("homepage_announcement")
  featureVisibility       Json     @map("feature_visibility")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model FlagInterest {
  id              String   @id @default(cuid())
  interestType    String   @map("interest_type")
  interestLabel   String   @map("interest_label")
  name            String
  ageRange        String   @map("age_range")
  location        String
  whatsapp        String
  whatsappDigits  String   @map("whatsapp_digits")
  experience      String?  @default("")
  company         String?  @default("")
  sponsorInterest String?  @default("") @map("sponsor_interest")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([interestType, createdAt])
  @@index([whatsappDigits, createdAt])
  @@map("flag_interests")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  actorName   String   @map("actor_name")
  actorEmail  String   @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  entityLabel String?  @map("entity_label")
  summary     String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("admin_audit_logs")
}

model PlayerStatistics {
  id           String @id @default(cuid())
  playerId     String @map("player_id")
  tournamentId String @map("tournament_id")
  divisionId   String @map("division_id")
  passing      Json
  rushing      Json
  receiving    Json
  defensive    Json
  gamesPlayed  Int    @default(0) @map("games_played")

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  @@unique([playerId, tournamentId, divisionId])
  @@index([tournamentId, divisionId])
  @@index([playerId])
  @@map("player_statistics")
}

model TeamStatistics {
  id                   String @id @default(cuid())
  teamId               String @map("team_id")
  tournamentId         String @map("tournament_id")
  divisionId           String @map("division_id")
  wins                 Int    @default(0)
  losses               Int    @default(0)
  ties                 Int    @default(0)
  pointsFor            Int    @default(0) @map("points_for")
  pointsAgainst        Int    @default(0) @map("points_against")
  pointsDifferential   Int    @default(0) @map("points_differential")
  offensiveStats       Json   @map("offensive_stats")
  defensiveStats       Json   @map("defensive_stats")
  turnovers            Int    @default(0)
  turnoverDifferential Int    @default(0) @map("turnover_differential")
  penalties            Int    @default(0)
  penaltyYards         Int    @default(0) @map("penalty_yards")

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  @@unique([teamId, tournamentId, divisionId])
  @@index([tournamentId, divisionId])
  @@index([teamId])
  @@map("team_statistics")
}

model TournamentDivision {
  tournamentId String @map("tournament_id")
  divisionId   String @map("division_id")
  ordinal      Int    @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([tournamentId, divisionId])
  @@map("tournament_divisions")
}

model TournamentTeam {
  tournamentId String @map("tournament_id")
  teamId       String @map("team_id")
  ordinal      Int    @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([tournamentId, teamId])
  @@map("tournament_teams")
}

model DivisionTeam {
  divisionId String @map("division_id")
  teamId     String @map("team_id")
  ordinal    Int    @default(0)

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([divisionId, teamId])
  @@map("division_teams")
}

model TeamPlayer {
  teamId   String @map("team_id")
  playerId String @map("player_id")
  ordinal  Int    @default(0)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@map("team_players")
}

model GamePresentPlayer {
  gameId   String @map("game_id")
  playerId String @map("player_id")
  side     String
  ordinal  Int    @default(0)

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([gameId, playerId, side])
  @@index([gameId, side, ordinal])
  @@map("game_present_players")
}

model FantasyUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passwordResets    FantasyPasswordReset[]
  featureAssignments FantasyFeatureAssignment[]
  auditLogs          FantasyAuditLog[]
  leagueMemberships  FantasyLeagueMember[]
  commissionedLeagues FantasyLeague[] @relation("FantasyLeagueCommissioner")
  playerFavorites     FantasyPlayerFavorite[]
  onboarding          FantasyOnboarding?

  @@map("fantasy_users")
}

model FantasyPasswordReset {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user FantasyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, codeHash, consumedAt])
  @@index([expiresAt])
  @@map("fantasy_password_resets")
}

model FantasyFeatureAssignment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  key       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user FantasyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key, enabled])
  @@map("fantasy_feature_assignments")
}

model FantasyAuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor FantasyUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("fantasy_audit_logs")
}

model FantasyOnboarding {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  version     Int      @default(1)
  status      String   @default("not_started")
  currentStep String   @default("welcome") @map("current_step")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user FantasyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("fantasy_onboardings")
}

model FantasyLeague {
  id              String   @id @default(cuid())
  name            String
  inviteCode      String   @unique @map("invite_code")
  commissionerId  String   @map("commissioner_id")
  status          String   @default("lobby")
  maxMembers      Int      @default(8) @map("max_members")
  // Legacy column retained as the configurable number of bench players.
  rosterSize      Int      @default(4) @map("roster_size")
  turnSeconds     Int      @default(90) @map("turn_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  commissioner FantasyUser         @relation("FantasyLeagueCommissioner", fields: [commissionerId], references: [id], onDelete: Restrict)
  members      FantasyLeagueMember[]
  draft        FantasyDraft?

  @@index([commissionerId, createdAt])
  @@index([status])
  @@map("fantasy_leagues")
}

model FantasyLeagueMember {
  id        String   @id @default(cuid())
  leagueId  String   @map("league_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  status    String   @default("active")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  league FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   FantasyUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   FantasyTeam?
  picks  FantasyDraftPick[]

  @@unique([leagueId, userId])
  @@index([userId, status])
  @@map("fantasy_league_members")
}

model FantasyTeam {
  id        String   @id @default(cuid())
  memberId  String   @unique @map("member_id")
  name      String
  avatar    String?  @map("avatar")
  budget    Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member FantasyLeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  picks  FantasyDraftPick[]

  @@map("fantasy_teams")
}

model FantasyDraft {
  id              String    @id @default(cuid())
  leagueId        String    @unique @map("league_id")
  status          String    @default("pending")
  currentPick     Int       @default(1) @map("current_pick")
  startedAt       DateTime? @map("started_at")
  pickDeadline    DateTime? @map("pick_deadline")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  league FantasyLeague     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  picks  FantasyDraftPick[]

  @@index([status, pickDeadline])
  @@map("fantasy_drafts")
}

model FantasyDraftPick {
  id        String   @id @default(cuid())
  draftId   String   @map("draft_id")
  memberId  String   @map("member_id")
  teamId    String   @map("team_id")
  playerId  String?  @map("player_id")
  defenseTeamId String? @map("defense_team_id")
  round     Int
  overall   Int      @map("overall")
  autoPicked Boolean @default(false) @map("auto_picked")
  createdAt DateTime @default(now()) @map("created_at")

  draft  FantasyDraft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  member FantasyLeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  team   FantasyTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player?             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  defenseTeam Team?          @relation("FantasyDraftPickDefenseTeam", fields: [defenseTeamId], references: [id], onDelete: Restrict)

  @@unique([draftId, playerId])
  @@unique([draftId, defenseTeamId])
  @@unique([draftId, overall])
  @@index([teamId, createdAt])
  @@map("fantasy_draft_picks")
}

model FantasyPlayerFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  playerId  String?  @map("player_id")
  defenseTeamId String? @map("defense_team_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   FantasyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player?     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  defenseTeam Team?  @relation("FantasyFavoriteDefenseTeam", fields: [defenseTeamId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId])
  @@unique([userId, defenseTeamId])
  @@index([userId, createdAt])
  @@map("fantasy_player_favorites")
}

model DigitalCredential {
  id               String    @id @default(cuid())
  publicId         String    @unique @default(cuid()) @map("public_id")
  userId           String    @map("user_id")
  playerId         String?   @map("player_id")
  judgeId          String?   @map("judge_id")
  subjectType      String    @map("subject_type")
  memberNumber     String    @unique @map("member_number")
  displayName      String    @map("display_name")
  profilePicture   String?   @map("profile_picture")
  roleLabel        String    @map("role_label")
  organizationName String    @map("organization_name")
  nationalityCode  String    @map("nationality_code")
  dateOfBirth      DateTime  @map("date_of_birth")
  status           String    @default("active")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  renewedFromId    String?   @map("renewed_from_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user   User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  player Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  judge  Judge?   @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  audits DigitalCredentialAudit[]

  @@index([userId, status])
  @@index([playerId])
  @@index([judgeId])
  @@index([status, expiresAt])
  @@map("digital_credentials")
}

model CommerceSeller {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  kind        String   @default("partner")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members CommerceSellerMember[]
  items   CommerceItem[]
  orders  CommerceOrder[]

  @@index([status, name])
  @@map("commerce_sellers")
}

model CommerceSellerMember {
  id        String   @id @default(cuid())
  sellerId  String   @map("seller_id")
  userId    String   @map("user_id")
  role      String   @default("manager")
  createdAt DateTime @default(now()) @map("created_at")

  seller CommerceSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([userId])
  @@map("commerce_seller_members")
}

model CommerceItem {
  id                    String   @id @default(cuid())
  sellerId              String   @map("seller_id")
  tournamentId          String?  @map("tournament_id")
  slug                  String   @unique
  kind                  String
  title                 String
  description           String
  imageUrl              String?  @map("image_url")
  imageUrls             Json?    @map("image_urls")
  sku                   String?
  details               Json?
  pickupInstructions    String?  @map("pickup_instructions")
  priceMinor            Int      @map("price_minor")
  currency              String   @default("UYU")
  credentialDiscountBps Int      @default(0) @map("credential_discount_bps")
  stockQuantity         Int?     @map("stock_quantity")
  entitlementMonths     Int?     @map("entitlement_months")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  seller      CommerceSeller @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  tournament  Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  orderItems  CommerceOrderItem[]
  registrations CommerceTournamentRegistration[]
  variants    CommerceItemVariant[]

  @@index([sellerId, active])
  @@index([kind, active])
  @@map("commerce_items")
}

model CommerceOrder {
  id                    String    @id @default(cuid())
  buyerUserId           String    @map("buyer_user_id")
  sellerId              String    @map("seller_id")
  status                String    @default("creating")
  fulfillmentStatus     String    @default("pending_fulfillment") @map("fulfillment_status")
  pickupInstructions    String?   @map("pickup_instructions")
  currency              String    @default("UYU")
  subtotalMinor         Int       @map("subtotal_minor")
  discountMinor         Int       @default(0) @map("discount_minor")
  totalMinor            Int       @map("total_minor")
  idempotencyKey        String    @unique @map("idempotency_key")
  payloadFingerprint    String    @map("payload_fingerprint")
  providerOrderId       String?   @unique @map("provider_order_id")
  providerStatus        String?   @map("provider_status")
  checkoutUrl           String?   @map("checkout_url")
  liveMode              Boolean   @map("live_mode")
  reservationExpiresAt  DateTime  @map("reservation_expires_at")
  paidAt                DateTime? @map("paid_at")
  fulfilledAt           DateTime? @map("fulfilled_at")
  cancelledAt           DateTime? @map("cancelled_at")
  refundedMinor         Int       @default(0) @map("refunded_minor")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  buyer  User           @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller CommerceSeller @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items   CommerceOrderItem[]
  refundRequests CommerceRefundRequest[]
  registrations CommerceTournamentRegistration[]

  @@index([buyerUserId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, reservationExpiresAt])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id                    String @id @default(cuid())
  orderId               String @map("order_id")
  itemId                String @map("item_id")
  variantId             String? @map("variant_id")
  title                 String
  kind                  String
  quantity              Int
  unitPriceMinor        Int    @map("unit_price_minor")
  unitDiscountMinor     Int    @default(0) @map("unit_discount_minor")
  entitlementMonths     Int?   @map("entitlement_months")
  variantSku            String? @map("variant_sku")
  variantLabel          String? @map("variant_label")

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  CommerceItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([variantId])
  @@map("commerce_order_items")
}

model CommerceItemVariant {
  id            String   @id @default(cuid())
  itemId        String   @map("item_id")
  sku           String
  label         String
  optionName    String   @map("option_name")
  optionValue   String   @map("option_value")
  priceMinor    Int?     @map("price_minor")
  stockQuantity Int?     @map("stock_quantity")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  item CommerceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, sku])
  @@index([itemId, active])
  @@map("commerce_item_variants")
}

model CommerceWebhookEvent {
  id                 String    @id @default(cuid())
  deliveryKey        String    @unique @map("delivery_key")
  providerResourceId String    @map("provider_resource_id")
  action             String
  liveMode           Boolean   @map("live_mode")
  status             String    @default("received")
  attempts           Int       @default(0)
  error              String?
  receivedAt         DateTime  @default(now()) @map("received_at")
  processedAt        DateTime? @map("processed_at")

  @@index([status, receivedAt])
  @@index([providerResourceId, receivedAt])
  @@map("commerce_webhook_events")
}

model CommerceTournamentRegistration {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  itemId       String   @map("item_id")
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  status       String   @default("reserved")
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime @default(now()) @map("created_at")

  order      CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  item       CommerceItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([itemId, userId])
  @@index([orderId, status])
  @@index([tournamentId, createdAt])
  @@map("commerce_tournament_registrations")
}

model CommerceRefundRequest {
  id             String    @id @default(cuid())
  orderId        String    @map("order_id")
  requestedById  String    @map("requested_by_id")
  amountMinor    Int       @map("amount_minor")
  reason         String
  status         String    @default("requested")
  providerRefundId String? @unique @map("provider_refund_id")
  reviewedById   String?   @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("commerce_refund_requests")
}

model DigitalCredentialAudit {
  id           String   @id @default(cuid())
  credentialId String?  @map("credential_id")
  action       String
  createdAt    DateTime @default(now()) @map("created_at")

  credential DigitalCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([credentialId, createdAt])
  @@index([action, createdAt])
  @@map("digital_credential_audits")
}
