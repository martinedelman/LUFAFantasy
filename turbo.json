{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "DIRECT_URL",
    "JWT_SECRET",
    "FANTASY_JWT_SECRET",
    "FANTASY_RESET_SECRET",
    "OTP_SECRET",
    "INSTITUTIONAL_APP_URL",
    "APP_URL",
    "NEXT_PUBLIC_APP_URL",
    "CRON_SECRET",
    "MAIL_FROM",
    "MAIL_PROVIDER",
    "SMTP_*",
    "GOOGLE_*",
    "BLOB_READ_WRITE_TOKEN",
    "FLAGS",
    "FLAGS_SECRET",
    "environment",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "POSTGRES_PASSWORD",
    "POSTGRES_USER",
    "ZOHO_ACCOUNT_TYPE"
  ],
  "tasks": {
    "generate": { "cache": false },
    "build": {
      "dependsOn": ["^build", "generate"],
      "env": ["API_URL", "APP_ENV", "environment", "DATABASE_PROVIDER", "DATABASE_URL", "MONGODB_URI", "MONGODB_DATABASE"]
    },
    "@lufa/api#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**"],
      "env": ["APP_ENV", "environment", "DATABASE_PROVIDER", "DATABASE_URL", "MONGODB_URI", "MONGODB_DATABASE"]
    },
    "@lufa/institutional#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": ["APP_ENV", "APP_URL", "API_URL"]
    },
    "@lufa/lufa-institutional#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": ["APP_ENV", "APP_URL", "API_URL", "NEXT_PUBLIC_APP_URL", "NEXT_PUBLIC_FLAG_URL"]
    },
    "@lufa/fantasy#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": ["APP_ENV", "APP_URL", "API_URL"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"] },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "APP_ENV",
        "APP_URL",
        "API_URL",
        "DATABASE_PROVIDER",
        "DATABASE_URL",
        "DIRECT_URL",
        "MONGODB_URI",
        "MONGODB_DATABASE",
        "JWT_SECRET",
        "FANTASY_JWT_SECRET",
        "FANTASY_RESET_SECRET",
        "OTP_SECRET",
        "INSTITUTIONAL_APP_URL",
        "NEXT_PUBLIC_APP_URL",
        "CRON_SECRET",
        "SMTP_*",
        "GOOGLE_*",
        "BLOB_READ_WRITE_TOKEN"
      ]
    }
  }
}
