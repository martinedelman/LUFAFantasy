# Copy this file to .env for local development. .env is ignored by Git: never
# commit real credentials. Set production and preview values in Vercel instead.
#
# PostgreSQL is the active provider in this template. MongoDB is retained only
# for the legacy provider, data migration, and rollback procedures.

# =====================================================
# REQUIRED: APP RUNTIME
# =====================================================
# Application environment. This is LUFA's own setting, not NODE_ENV.
# Allowed values: development | production
APP_ENV=development

# Public URL used in emails, metadata, and links. NEXT_PUBLIC_ means this value
# is intentionally exposed to the browser; do not put a secret here.
# APP_URL is an old server-only fallback and VERCEL_URL is injected by Vercel;
# neither should be added to new local configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Active persistence provider. Set explicitly; do not rely on the legacy
# mongodb fallback when this key is omitted.
DATABASE_PROVIDER=postgres

# PostgreSQL connection used by the app, Prisma CLI, and migration script.
# Keep schema=public for normal local development.
DATABASE_URL=postgresql://lufa:lufa_local@127.0.0.1:5434/lufa_fantasy?schema=public

# Required for session cookies. Generate a different value per environment:
#   openssl rand -base64 32
JWT_SECRET=


# =====================================================
# LOCAL DOCKER DATABASES
# =====================================================
# These values initialize docker-compose services. They do not automatically
# rewrite DATABASE_URL, so keep both PostgreSQL configurations in sync.
POSTGRES_PORT=5434
POSTGRES_USER=lufa
POSTGRES_PASSWORD=lufa_local
POSTGRES_DB=lufa_fantasy

# Used only when starting MongoDB with docker-compose.
MONGODB_PORT=27017


# =====================================================
# OPTIONAL: LEGACY MONGODB / DATA MIGRATION
# =====================================================
# Required only when DATABASE_PROVIDER=mongodb, running a Mongo -> PostgreSQL
# migration, or using the Mongo rollback/sync scripts. The migration selects
# its source database with --source-db, so no database name is needed here.
MONGODB_URI=mongodb://127.0.0.1:27017

# The legacy key `environment` is still accepted for existing deployments.
# Use APP_ENV for all new configuration.


# =====================================================
# OPTIONAL: OTP AND EMAIL
# =====================================================
# Separate OTP pepper. Leave empty to reuse JWT_SECRET.
OTP_SECRET=

# SMTP is optional locally. In production, SMTP_HOST, SMTP_USER, and SMTP_PASS
# are required before the app can send email. MAIL_PROVIDER controls defaults
# for port/security (for example, zeptomail uses 465 + TLS).
MAIL_FROM="LUFA Flag <no-reply@example.com>"
MAIL_PROVIDER=zeptomail
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=


# =====================================================
# OPTIONAL: VERCEL BLOB AND FEATURE FLAGS
# =====================================================
# Required only for image uploads through Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Provisioned by Vercel Flags. Leave both empty to keep feature flags disabled.
FLAGS=
FLAGS_SECRET=


# =====================================================
# OPTIONAL: CRONS AND GOOGLE SHEETS IMPORT
# =====================================================
# Required to authorize the cron endpoints.
CRON_SECRET=

# All four values are required only for player import from Google Sheets.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME="Respuestas de formulario 1"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Preserve escaped newlines when pasting this value.
GOOGLE_PRIVATE_KEY=""
