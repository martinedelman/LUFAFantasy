APP_ENV=testing
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://user:password@host:6543/database?schema=public
DIRECT_URL=postgresql://user:password@host:5432/database?schema=public

# Fallback manual; sólo se usa con DATABASE_PROVIDER=mongodb.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=test

JWT_SECRET=change-this-to-a-long-random-secret
FANTASY_JWT_SECRET=change-this-to-a-different-long-random-secret
FANTASY_RESET_SECRET=change-this-to-another-long-random-secret
OTP_SECRET=change-this-to-a-long-random-otp-secret
INSTITUTIONAL_APP_URL=http://localhost:3000
NEXT_PUBLIC_LUFA_URL=http://localhost:3003
FANTASY_APP_URL=http://localhost:3002
CRON_SECRET=change-this-to-a-long-random-cron-secret

# Checkout Pro vía Orders API. Configure valores diferentes en Preview y Production.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_APPLICATION_ID=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_EXPECTED_LIVE_MODE=false
LUFA_PUBLIC_APP_URL=http://localhost:3003
COMMERCE_RESERVATION_MINUTES=30
COMMERCE_MAX_INSTALLMENTS=12
COMMERCE_ENABLED=false

# Set MAIL_PROVIDER=gmail-api and fill GOOGLE_GMAIL_* to send with Gmail OAuth.
MAIL_FROM="LUFA Flag <lufaflag@gmail.com>"
MAIL_PROVIDER=
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

BLOB_READ_WRITE_TOKEN=vercel_blob
GOOGLE_SHEETS_SPREADSHEET_ID=your-sheet-id
GOOGLE_SHEETS_TAB_NAME=Respuestas de formulario 1
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
